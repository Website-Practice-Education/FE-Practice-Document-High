# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# IMPORTANT: Update these URLs to your production API server
# These values are used when building with: npm run build

# Production API URL - UPDATE THIS
VITE_API_URL=https://your-api-domain.com/api
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_API_BASE_URL_SECURE=https://your-api-domain.com/api

# Production SignalR Hub URL - UPDATE THIS
VITE_SIGNALR_HUB_URL=https://your-api-domain.com/hubs/chat
VITE_SIGNALR_HUB_URL_SECURE=https://your-api-domain.com/hubs/chat

# Google OAuth - Use production credentials
VITE_GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID

# Gemini API - Use production key
VITE_GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
