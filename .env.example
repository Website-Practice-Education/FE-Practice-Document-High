# API Configuration
VITE_API_URL=http://localhost:5058/api
VITE_API_TIMEOUT=30000

# Google OAuth Configuration
# Lấy Google Client ID từ: https://console.cloud.google.com/apis/credentials
# 1. Tạo project mới hoặc chọn project hiện tại
# 2. Tạo OAuth 2.0 Client ID (Web application)
# 3. Thêm authorized redirect URIs: http://localhost:5173 (dev) hoặc production URL
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
